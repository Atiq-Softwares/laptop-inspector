<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Atiq-Laptop-Inspector</AssemblyName>
    <RootNamespace>Inspector.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\third-party\smartmontools\smartctl.exe;..\..\third-party\smartmontools\drivedb.h;..\..\third-party\smartmontools\COPYING.txt;..\..\third-party\smartmontools\INSTALL.txt;..\..\third-party\smartmontools\README.txt;..\..\third-party\smartmontools\AUTHORS.txt;..\..\third-party\smartmontools\smartmontools-7.5.tar.gz" Link="third-party\smartmontools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ProjectReference Include="..\Inspector.Core\Inspector.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.3" />
  </ItemGroup>
</Project>
